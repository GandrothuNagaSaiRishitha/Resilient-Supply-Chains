# Select "mock" to use illustrative datasets or "api" to call the backend.
VITE_DATA_SOURCE=api

# Required when VITE_DATA_SOURCE=api.
VITE_API_BASE_URL=http://127.0.0.1:8000

# General API timeout. Memory and decision-report requests have longer limits
# because they wait on Hindsight and Groq provider calls.
VITE_API_TIMEOUT_MS=15000
VITE_MEMORY_API_TIMEOUT_MS=180000
VITE_DECISION_API_TIMEOUT_MS=600000
